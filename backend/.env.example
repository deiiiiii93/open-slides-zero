ZENMUX_API_KEY=sk-your-key-here
ZENMUX_BASE_URL=https://zenmux.ai/api/v1

OSZ_CHECKPOINT_DB=./threads.sqlite
OSZ_ARTIFACTS_DIR=./threads
OSZ_LOG_LEVEL=INFO

# Per-node model overrides (all optional). Each key is OSZ_MODEL_<node>
# where <node> replaces '.' with '_'. See backend/app/llm/models.py for defaults.
# OSZ_MODEL_OUTLINE=anthropic/claude-sonnet-4.6
# OSZ_MODEL_STYLE_VISION=google/gemini-3.1-pro-preview
# OSZ_MODEL_HTML=anthropic/claude-sonnet-4.6
