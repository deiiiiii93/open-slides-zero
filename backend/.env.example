ZENMUX_API_KEY=replace-with-your-zenmux-api-key
ZENMUX_BASE_URL=https://zenmux.ai/api/v1

OSZ_CHECKPOINT_DB=./threads.sqlite
OSZ_ARTIFACTS_DIR=./threads
OSZ_LOG_LEVEL=INFO
OSZ_HTML_MAX_TOKENS=12000
OSZ_HTML_TIMEOUT_SECONDS=180
OSZ_HTML_MAX_ATTEMPTS=2

# Optional: standalone OCR via Z.AI's glm-ocr layout_parsing endpoint.
# When all three are set, image materials and rasterized PDF pages go to this
# endpoint instead of the ZenMux vision path. Purpose-built for documents and
# much cheaper than general VLMs. Leave unset to keep the ZenMux fallback.
# OSZ_MODEL_OCR=glm-ocr
# OSZ_MODEL_OCR_BASE_URL=https://api.z.ai/api/paas/v4/layout_parsing
# OSZ_MODEL_OCR_KEY=your-z-ai-key

# Per-node model overrides (all optional). Each key is OSZ_MODEL_<node>
# where <node> replaces '.' with '_'. See backend/app/llm/models.py for defaults.
# OSZ_MODEL_OUTLINE=anthropic/claude-sonnet-4.6
# OSZ_MODEL_STYLE_VISION=google/gemini-3.1-pro-preview
# OSZ_MODEL_HTML=anthropic/claude-sonnet-4.6
